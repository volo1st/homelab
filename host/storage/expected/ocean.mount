# Automatically generated by systemd-fstab-generator

[Unit]
Documentation=man:fstab(5) man:systemd-fstab-generator(8)
SourcePath=/etc/fstab
RequiresMountsFor=/mnt/disks/ssd1 /mnt/disks/ssd2 /mnt/disks/ssd3 /mnt/disks/ssd4

[Mount]
What=/mnt/disks/ssd1:/mnt/disks/ssd2:/mnt/disks/ssd3:/mnt/disks/ssd4
Where=/ocean
Type=fuse.mergerfs
Options=defaults,nonempty,allow_other,use_ino,cache.files=partial,dropcacheonclose=true,category.create=epmfs,minfreespace=50G,nofail,x-systemd.requires-mounts-for=/mnt/disks/ssd1,x-systemd.requires-mounts-for=/mnt/disks/ssd2,x-systemd.requires-mounts-for=/mnt/disks/ssd3,x-systemd.requires-mounts-for=/mnt/disks/ssd4,fsname=mergerfs_pool
