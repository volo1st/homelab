:if ([:len [/ip service find where name="ssh" and dynamic=no]] != 1) do={:error "Expected one static ssh service"}; :if ([/ip service get [/ip service find where name="ssh" and dynamic=no] disabled]) do={:error "Expected ssh enabled"}; :if ([:len [/ip service find where name="www" and dynamic=no]] != 1) do={:error "Expected one static www service"}; :if ([/ip service get [/ip service find where name="www" and dynamic=no] disabled]) do={:error "Expected www enabled"}; :if ([:len [/ip service find where name="ftp" and dynamic=no]] != 1) do={:error "Expected one static ftp service"}; :if ([/ip service get [/ip service find where name="ftp" and dynamic=no] disabled]) do={:error "Expected ftp enabled"}; :if ([:len [/ip service find where name="telnet" and dynamic=no]] != 1) do={:error "Expected one static telnet service"}; :if ([/ip service get [/ip service find where name="telnet" and dynamic=no] disabled]) do={:error "Expected telnet enabled"}; :if ([:len [/ip service find where name="winbox" and dynamic=no]] != 1) do={:error "Expected one static winbox service"}; :if ([/ip service get [/ip service find where name="winbox" and dynamic=no] disabled]) do={:error "Expected winbox enabled"}; :if ([:len [/ip service find where name="api" and dynamic=no]] != 1) do={:error "Expected one static api service"}; :if ([/ip service get [/ip service find where name="api" and dynamic=no] disabled]) do={:error "Expected api enabled"}; :if ([:len [/ip service find where name="api-ssl" and dynamic=no]] != 1) do={:error "Expected one static api-ssl service"}; :if ([/ip service get [/ip service find where name="api-ssl" and dynamic=no] disabled]) do={:error "Expected api-ssl enabled"}; :if ([:len [/ip service find where name="reverse-proxy" and dynamic=no]] != 1) do={:error "Expected one static reverse-proxy service"}; :if ([/ip service get [/ip service find where name="reverse-proxy" and dynamic=no] disabled]) do={:error "Expected reverse-proxy enabled"}; :if ([/tool bandwidth-server get enabled] != true) do={:error "Expected bandwidth server enabled"}; /ip service set [/ip service find where name="ftp" and dynamic=no] disabled=yes; /ip service set [/ip service find where name="telnet" and dynamic=no] disabled=yes; /ip service set [/ip service find where name="winbox" and dynamic=no] disabled=yes; /ip service set [/ip service find where name="api" and dynamic=no] disabled=yes; /ip service set [/ip service find where name="api-ssl" and dynamic=no] disabled=yes; /ip service set [/ip service find where name="reverse-proxy" and dynamic=no] disabled=yes; /tool bandwidth-server set enabled=no; :put "UNUSED_MANAGEMENT_DISABLED"
