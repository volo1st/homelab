/ip service set [/ip service find where name="ftp" and dynamic=no] disabled=no; /ip service set [/ip service find where name="telnet" and dynamic=no] disabled=no; /ip service set [/ip service find where name="winbox" and dynamic=no] disabled=no; /ip service set [/ip service find where name="api" and dynamic=no] disabled=no; /ip service set [/ip service find where name="api-ssl" and dynamic=no] disabled=no; /ip service set [/ip service find where name="reverse-proxy" and dynamic=no] disabled=no; /tool bandwidth-server set enabled=yes; :put "MANAGEMENT_ROLLBACK_APPLIED"
