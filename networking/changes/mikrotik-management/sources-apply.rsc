:if ([:len [/ip service find where name="ssh" and dynamic=no]] != 1) do={:error "Expected one service"}; :if ([:len [/ip service get [/ip service find where name="ssh" and dynamic=no] address]] != 0) do={:error "Source policy already changed"}; :if ([/ip service get [/ip service find where name="ssh" and dynamic=no] disabled]) do={:error "Required service disabled"}; :if ([:len [/ip service find where name="www" and dynamic=no]] != 1) do={:error "Expected one service"}; :if ([:len [/ip service get [/ip service find where name="www" and dynamic=no] address]] != 0) do={:error "Source policy already changed"}; :if ([/ip service get [/ip service find where name="www" and dynamic=no] disabled]) do={:error "Required service disabled"}; /ip service set [/ip service find where name="ssh" and dynamic=no] address=192.168.88.0/24,fe80::/10; /ip service set [/ip service find where name="www" and dynamic=no] address=192.168.88.0/24,fe80::/10; :put "MANAGEMENT_SOURCES_APPLIED"
