# Reviewed native configuration, 2026-10-20. Restore private values before use.

config interface 'loopback'
	option device 'lo'
	option proto 'static'
	list ipaddr '127.0.0.1/8'

config globals 'globals'
	option dhcp_default_duid '00049f126defd3cd48c8b8f4d856341a47b4'
	option ula_prefix 'fd71:ad51:c45d::/48'

config device
	option name 'br-lan'
	option type 'bridge'
	list ports 'lan1'
	list ports 'lan2'
	list ports 'wan'
	option stp '0'
	option igmp_snooping '0'

config interface 'lan'
	option device 'br-lan'
	option proto 'static'
	option ipaddr '192.168.88.5'
	option netmask '255.255.255.0'
	option gateway '192.168.88.1'
	option dns '192.168.88.1'
