# Reviewed native configuration, 2026-10-20. Restore private values before use.

config wifi-device 'radio0'
	option type 'mac80211'
	option path 'platform/soc@0/c000000.wifi'
	option band '5g'
	option channel '153'
	option htmode 'HE80'
	option country 'AU'
	option disabled '0'
	option cell_density '0'

config wifi-device 'radio1'
	option type 'mac80211'
	option path 'platform/soc@0/c000000.wifi+1'
	option band '2g'
	option channel '1'
	option htmode 'HE20'
	option disabled '1'

config wifi-iface 'wds_ap'
	option device 'radio0'
	option network 'lan'
	option mode 'ap'
	option ssid 'Secret Cow Level'
	option encryption 'psk2'
	option key '<PRIVATE_AXT1800_KEY_1>'
	option wds '1'
	option multicast_to_unicast '0'
	option disassoc_low_ack '0'
	option macaddr '5E:81:E0:EE:07:05'
