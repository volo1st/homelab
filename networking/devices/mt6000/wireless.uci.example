config wifi-device 'mt798611'
	option type 'mtk'
	option band '2g'
	option htmode 'HE40'
	option channel 'auto'
	option txpower '100'
	option random_bssid '1'
	option disabled '0'
	option legacy_rates '0'
	option country 'AU'

